ONBOARDING_RUNTIME_MODE=local
ONBOARDING_DEFAULT_TIMEZONE=Asia/Tbilisi
ONBOARDING_QUIET_HOURS_START=19
ONBOARDING_QUIET_HOURS_END=10
ONBOARDING_MAX_MESSAGE_CHARACTERS=2000

# Live integration mode
ONBOARDING_DATABASE_URL=postgresql://user:password@host:5432/database
ONBOARDING_SLACK_BOT_TOKEN=replace-with-slack-bot-token
ONBOARDING_SLACK_APP_TOKEN=replace-with-slack-app-token
ONBOARDING_GOOGLE_API_KEY=replace-me
ONBOARDING_GOOGLE_MODEL=gemini-2.0-flash
ONBOARDING_GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
ONBOARDING_GOOGLE_CLOUD_PROJECT=replace-me
ONBOARDING_GOOGLE_CLOUD_LOCATION=us-central1
ONBOARDING_DRIVE_FOLDER_ID=replace-me
ONBOARDING_KNOWLEDGE_CACHE_SECONDS=900
